# --- Core -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://tochkacomp.ru"

# --- Database (optional) ----------------------------------------------------
# Leave unset to run on the bundled static catalogue (see src/shared/api/README.md).
# DATABASE_URL="postgresql://user:password@localhost:5432/tochkacomp?schema=public"

# --- Auth.js ----------------------------------------------------------------
# AUTH_SECRET="run: npx auth secret"
# AUTH_YANDEX_ID=""
# AUTH_YANDEX_SECRET=""

# --- Search (Algolia) -------------------------------------------------------
# Unset => the local BM25-ish index in src/features/search is used instead.
# NEXT_PUBLIC_ALGOLIA_APP_ID=""
# NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=""
# ALGOLIA_ADMIN_KEY=""

# --- Storage (Cloudflare R2) ------------------------------------------------
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="tochkacomp-media"

# --- Email (Resend) ---------------------------------------------------------
# RESEND_API_KEY=""
# ORDER_NOTIFICATION_EMAIL="orders@tochkacomp.ru"

# --- Analytics --------------------------------------------------------------
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
# NEXT_PUBLIC_CLARITY_ID=""

# --- Revalidation webhook ---------------------------------------------------
# REVALIDATE_SECRET=""
